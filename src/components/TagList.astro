---
import { slugify } from '../utils/slugify';
interface Props { tags: string[]; showLabel?: boolean; limit?: number; }
const { tags, showLabel = false, limit } = Astro.props;
const visible = limit ? tags.slice(0, limit) : tags;
---
<div class="tag-list">
  {showLabel && <span class="muted">Tags:</span>}
  <ul class="tags">
    {visible.map((tag) => <li><a class="tag-link" href={`/tags/${slugify(tag)}/`}><span aria-hidden="true">#</span>{tag}</a></li>)}
    {limit && tags.length > limit && <li class="muted">+{tags.length - limit} more</li>}
  </ul>
</div>
