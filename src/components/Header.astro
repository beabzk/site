---
import ThemeToggle from './ThemeToggle.astro';
const links = [
  { href: '/', label: 'Home' }, { href: '/blog', label: 'Blog' },
  { href: '/projects', label: 'Projects' }, { href: '/tags', label: 'Tags' }, { href: '/contact', label: 'Contact' }, { href: '/about', label: 'About' },
];
const pathname = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(href + '/');
---
<a class="skip-link" href="#main">Skip to main content</a>
<header class="site-header">
  <nav class="main-navigation" aria-label="Main navigation">
    {links.map((link) => <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>)}
    <ThemeToggle />
  </nav>
</header>
