---
import { SITE_AUTHOR, TAGLINES, SOCIAL_LINKS } from '../consts';
const tagline = TAGLINES[Math.floor(Math.random() * TAGLINES.length)];
---
<footer class="site-footer">
  <p>© {new Date().getFullYear()} {SITE_AUTHOR}. Built with Astro.</p>
  <p class="footer-tagline">{tagline}</p>
  <div class="footer-links">
    {SOCIAL_LINKS.map((link) => <a href={link.href} target={link.href.startsWith('mailto:') ? undefined : '_blank'} rel="noopener noreferrer">{link.label}</a>)}
    <a href="/rss.xml">RSS</a>
  </div>
</footer>
