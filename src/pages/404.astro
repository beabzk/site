---
import Base from '../layouts/Base.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---
<Base title={`Not Found - ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
  <section class="not-found"><p class="eyebrow">404</p><h1>That page does not exist.</h1>
    <p>The route you tried is not part of this version of the site. Use one of the main sections below instead.</p>
    <div class="hero-actions"><a href="/">Go home →</a><a href="/projects">Browse projects →</a><a href="/blog">Read the blog →</a></div>
  </section>
</Base>
