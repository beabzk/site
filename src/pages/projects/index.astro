---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectList from '../../components/ProjectList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
const projects = (await getCollection('projects', ({ data }) => import.meta.env.DEV || !data.draft)).sort((a, b) => {
  const featured = Number(Boolean(b.data.featured)) - Number(Boolean(a.data.featured));
  return featured || b.data.date.valueOf() - a.data.date.valueOf();
});
---
<Base title={`Projects - ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
  <header class="page-heading">
    <p class="eyebrow">Projects</p><h1>Work that shipped or taught me something worth keeping.</h1>
    <p>A mix of libraries, APIs, and applications. Some are polished, some are still evolving, but all of them represent real problems I cared enough to solve.</p>
  </header>
  <ProjectList projects={projects} />
</Base>
