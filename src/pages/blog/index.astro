---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BlogList from '../../components/BlogList.astro';
import TagList from '../../components/TagList.astro';
import { SITE_TITLE } from '../../consts';
const posts = (await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---
<Base title={`Blog - ${SITE_TITLE}`} description="Notes on software, systems, and building useful things.">
  <header class="page-heading"><h1>Blog</h1><p>Notes on software, systems, and building useful things.</p></header>
  <section data-search-archive>
    <div class="archive-tools">
      <label class="sr-only" for="article-search">Search articles</label>
      <input class="archive-search" id="article-search" type="search" placeholder="Search articles..." autocomplete="off" />
      <TagList tags={tags} />
      <a class="text-link" href="/tags">Browse all tags →</a>
    </div>
    <BlogList posts={posts} searchable />
    <p class="search-empty" role="status" hidden>No matching articles found.</p>
  </section>
</Base>
<script>
  const archive = document.querySelector<HTMLElement>('[data-search-archive]');
  const input = archive?.querySelector<HTMLInputElement>('input[type="search"]');
  if (archive && input) {
    const items = [...archive.querySelectorAll<HTMLElement>('[data-archive-item]')];
    const empty = archive.querySelector<HTMLElement>('.search-empty');
    const filter = (writeUrl: boolean) => {
      const query = input.value.trim().toLowerCase();
      const tokens = query.split(/\s+/).filter(Boolean);
      let count = 0;
      for (const item of items) {
        item.hidden = !tokens.every((token) => (item.dataset.search ?? '').includes(token));
        if (!item.hidden) count++;
      }
      if (empty) empty.hidden = count > 0;
      if (writeUrl) {
        const url = new URL(window.location.href);
        if (query) url.searchParams.set('q', input.value.trim());
        else url.searchParams.delete('q');
        history.replaceState(history.state, '', url);
      }
    };
    const restore = () => { input.value = new URLSearchParams(location.search).get('q') ?? ''; filter(false); };
    input.addEventListener('input', () => filter(true));
    window.addEventListener('popstate', restore);
    restore();
  }
</script>
