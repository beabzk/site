---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE_TITLE } from '../../consts';
import { slugify } from '../../utils/slugify';
const posts = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft);
const counts = new Map<string, number>();
for (const post of posts) for (const tag of post.data.tags) counts.set(tag, (counts.get(tag) ?? 0) + 1);
const tags = [...counts].sort(([a, countA], [b, countB]) => countB - countA || a.localeCompare(b));
---
<Base title={`All Tags - ${SITE_TITLE}`} description="Browse all blog tags">
  <header class="page-heading"><h1>Tags</h1><p>{tags.length} topics across all articles.</p></header>
  <ul class="tag-index">
    {tags.map(([tag, count]) => <li><a href={`/tags/${slugify(tag)}/`}><span><span class="accent">#</span>{tag}</span><span class="muted">{count} {count === 1 ? 'post' : 'posts'}</span></a></li>)}
  </ul>
</Base>
