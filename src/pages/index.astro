---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import BlogList from '../components/BlogList.astro';
import ProjectList from '../components/ProjectList.astro';
import { SITE_AUTHOR, SOCIAL_LINKS } from '../consts';
const posts = (await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
const projects = (await getCollection('projects', ({ data }) => import.meta.env.DEV || !data.draft))
  .filter((project) => project.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 4);
---
<Base>
  <section class="home-intro" aria-labelledby="intro-title">
    <h1 id="intro-title">{SITE_AUTHOR}</h1>
    <p class="role">Mechanical engineering student &amp; hobbyist programmer</p>
    <p class="intro-copy">Hey, I&apos;m {SITE_AUTHOR}. I study mechanical engineering, but I spend a lot of my free time programming.
      I write software to automate my routines, build utilities for things I enjoy, and fix daily annoyances. I build things to learn how they work.</p>
    <div class="contact-links">
      {SOCIAL_LINKS.map((link) => <span>[{link.label.toLowerCase()}: <a href={link.href} target={link.href.startsWith('mailto:') ? undefined : '_blank'} rel="noopener noreferrer">{link.href.startsWith('mailto:') ? link.href.slice(7) : '@beabzk'}</a>]</span>)}
    </div>
    <div class="hero-actions"><a href="/projects">See projects →</a><a href="/blog">Read the blog →</a></div>
  </section>
  <section class="home-section" aria-labelledby="featured-title">
    <div class="section-heading"><div><p class="eyebrow">Projects</p><h2 id="featured-title">Featured work</h2></div><a href="/projects">All projects →</a></div>
    <ProjectList projects={projects} />
  </section>
  <section class="home-section" aria-labelledby="writing-title">
    <div class="section-heading"><div><p class="eyebrow">Writing</p><h2 id="writing-title">Latest notes</h2></div><a href="/blog">All posts →</a></div>
    <BlogList posts={posts} />
  </section>
</Base>
