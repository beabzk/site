---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ProjectTagList from '../components/ProjectTagList.astro';
import TableOfContents from '../components/TableOfContents.astro';
import '../styles/archives.css';
type Props = CollectionEntry<'projects'>['data'] & { headings: MarkdownHeading[] };
const { title, description, date, tags, github, demo, docs, npm, featured, status, category, headings, draft } = Astro.props;
const links = [
  github && { href: github, label: 'Source' }, demo && { href: demo, label: 'Demo' },
  docs && { href: docs, label: 'Docs' }, npm && { href: npm, label: 'Package' },
].filter((link): link is { href: string; label: string } => Boolean(link));
---
<Base title={title} description={description} wide>
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Projects', href: '/projects' }, { label: title, href: Astro.url.pathname }]} />
  <div class="article-grid">
    <div class="article-main">
      <header class="article-header"><p class="eyebrow">Project</p><h1>{title}</h1><p>{description}</p>
        <div class="entry-meta"><FormattedDate date={date} /><span class:list={['project-status', { active: status === 'Active' }]}>{status}</span>{category && <span>{category}</span>}{featured && <span>Featured</span>}{draft && <span class="draft-label">Draft</span>}</div>
        <ProjectTagList tags={tags} />
        {links.length > 0 && <nav class="project-links" aria-label="Project links">{links.map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}<span aria-hidden="true"> ↗</span></a>)}</nav>}
      </header>
      <article class="prose" id="article-content"><slot /></article>
      <div class="article-footer"><a href="/projects">← Back to Projects</a></div>
    </div>
    <TableOfContents headings={headings} />
  </div>
</Base>
